{
  "manifest_version": 3,
  "name": "Thinkify Quiz Recommender",
  "version": "1.0",
  "description": "Recommends relevant quizzes from Thinkify Quiz Platform based on LinkedIn job postings",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thinkify Quiz Recommender"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["quiz-widget.html"],
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"]
    }
  ]
} 